// ─── keybindings: tmux parity ────────────────────────────────────────────────
//
// Prefix: Ctrl-Space, mirroring `programs.tmux.prefix = "C-Space"` in
// ../tmux/default.nix. `Ctrl @` is bound next to it because terminals without
// the kitty keyboard protocol report Ctrl-Space as NUL (^@), so binding both
// covers every terminal.
//
// Zellij is mode based, tmux is prefix based. The built-in `tmux` mode is used
// as the single prefix map, so `<prefix> <key>` does roughly what tmux does:
//
//   • focus / resize keys stay in the mode → repeat them without re-pressing the
//     prefix
//   • create / close / detach / popup bindings switch back to Normal
//   • Esc (or a second Ctrl-Space) leaves the prefix
//   • `prefix C-g` passes a literal Ctrl-Space (^@) to the focused pane, like
//     tmux's `bind C-b send-prefix` — handy for apps that want C-Space themselves
//
// Deliberately unbound (no zellij equivalent):
//   prefix `:`   tmux command prompt
//   prefix `q`   show-pane-numbers overlay   (`q` is kept as Quit, as before)
//   prefix `]`   paste-buffer               (use the terminal's paste)
//   prefix `(`/`)` previous/next session    (SwitchSession needs an explicit name)
//   prefix `$`   rename-session
//
// Tab numbering note: zellij tabs are 1-based. tmux windows here start at 0, so
// if you want the digits to line up exactly, add this to programs.tmux.extraConfig:
//   set -g base-index 1
//   setw -g renumber-windows on
keybinds clear-defaults=true {
  // enter the prefix from any mode except the prefix itself
  shared_except "tmux" {
    bind "Ctrl space" "Ctrl @" { SwitchToMode "Tmux"; }
  }

  locked {
    bind "Ctrl space" "Ctrl @" { SwitchToMode "Normal"; }
  }

  tmux {
    // ── leave the prefix
    bind "Ctrl space" "Esc" { SwitchToMode "Normal"; }
    // hand the "stolen" key back to the app
    bind "Ctrl g" { Write 0; SwitchToMode "Normal"; }

    // ── focus: prefix + h j k l / arrows (tmux vi-mode), stays in the mode
    bind "h" "Left" { MoveFocus "Left"; }
    bind "j" "Down" { MoveFocus "Down"; }
    bind "k" "Up" { MoveFocus "Up"; }
    bind "l" "Right" { MoveFocus "Right"; }
    bind "o" { FocusNextPane; } // tmux: prefix o
    bind ";" { FocusLastPane; } // zellij nicety: previously focused pane

    // ── resize: prefix + C-h C-j C-k C-l (tmux vi-mode, also covers the
    //    M-h/j/k/l of the tmux config), stays in the mode
    bind "Ctrl h" { Resize "Left"; }
    bind "Ctrl j" { Resize "Down"; }
    bind "Ctrl k" { Resize "Up"; }
    bind "Ctrl l" { Resize "Right"; }
    bind "Ctrl n" { SwitchToMode "Resize"; } // zellij resize mode: bigger/finer control

    // ── split: tmux's % and ", plus the `|` / `-` from the tmux config
    bind "|" "%" { NewPane "Right"; SwitchToMode "Normal"; }
    bind "-" "\"" { NewPane "Down"; SwitchToMode "Normal"; }

    // ── panes
    bind "x" { CloseFocus; SwitchToMode "Normal"; } // tmux kill-pane (no confirm prompt)
    bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; } // tmux zoom
    bind "!" { BreakPane; SwitchToMode "Normal"; } // tmux break-pane → own tab
    bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; } // zellij-only (tmux `f` find-window ≈ prefix w)
    bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
    bind "m" { SwitchToMode "Move"; } // zellij move mode (tmux `{` / `}`)

    // ── tabs == tmux windows
    bind "c" "T" { NewTab; SwitchToMode "Normal"; }
    bind "n" { GoToNextTab; }
    bind "p" { GoToPreviousTab; }
    bind "Tab" { ToggleTab; } // last window
    bind "," { SwitchToMode "RenameTab"; } // tmux rename-window
    bind "1" { GoToTab 1; SwitchToMode "Normal"; }
    bind "2" { GoToTab 2; SwitchToMode "Normal"; }
    bind "3" { GoToTab 3; SwitchToMode "Normal"; }
    bind "4" { GoToTab 4; SwitchToMode "Normal"; }
    bind "5" { GoToTab 5; SwitchToMode "Normal"; }
    bind "6" { GoToTab 6; SwitchToMode "Normal"; }
    bind "7" { GoToTab 7; SwitchToMode "Normal"; }
    bind "8" { GoToTab 8; SwitchToMode "Normal"; }
    bind "9" { GoToTab 9; SwitchToMode "Normal"; }

    // ── copy-mode
    bind "[" { SwitchToMode "Scroll"; }

    // ── session
    bind "d" { Detach; }
    bind "s" {
      Run "zellij" "run" "-cf" "--" "zellij_sessionizer.sh" {
        close_on_exit true
      }
      SwitchToMode "Normal"
    }
    bind "w" {
      LaunchOrFocusPlugin "zellij:session-manager" {
        floating true
        move_to_focused_tab true
      }
      SwitchToMode "Normal"
    }
    bind "L" { SwitchToMode "Locked"; }

    // ── apps, same as the tmux config
    bind "y" {
      Run "yazi" {
        close_on_exit true
        floating true
        x "10%"
        y "15%"
        width "80%"
        height "70%"
      }
      SwitchToMode "Normal"
    }
    bind "g" {
      Run "lazygit" {
        close_on_exit true
        floating true
        x "10%"
        y "15%"
        width "80%"
        height "70%"
      }
      SwitchToMode "Normal"
    }

    // ── layouts (tmux: prefix Space cycles layout)
    bind "Space" { NextSwapLayout; }

    // ── search
    bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }

    // quit is kept on prefix-q as before; tmux itself uses `q` for the
    // pane-number overlay, which zellij does not have.
    bind "Q" { Quit; }
    bind "q" { SwitchToMode "Normal"; }
  }

  // zellij's dedicated resize mode: reached with prefix C-n
  resize {
    bind "Esc" { SwitchToMode "Normal"; }
    bind "h" "Left" { Resize "Increase Left"; }
    bind "j" "Down" { Resize "Increase Down"; }
    bind "k" "Up" { Resize "Increase Up"; }
    bind "l" "Right" { Resize "Increase Right"; }
    bind "H" { Resize "Decrease Left"; }
    bind "J" { Resize "Decrease Down"; }
    bind "K" { Resize "Decrease Up"; }
    bind "L" { Resize "Decrease Right"; }
    bind "=" "+" { Resize "Increase"; }
    bind "-" { Resize "Decrease"; }
  }

  // zellij's move mode: reached with prefix m (≈ tmux `{` / `}` / M-o)
  move {
    bind "Esc" { SwitchToMode "Normal"; }
    bind "n" "Tab" { MovePane; }
    bind "p" { MovePaneBackwards; }
    bind "h" "Left" { MovePane "Left"; }
    bind "j" "Down" { MovePane "Down"; }
    bind "k" "Up" { MovePane "Up"; }
    bind "l" "Right" { MovePane "Right"; }
  }

  // scroll / copy-mode: reached with prefix [
  scroll {
    bind "Esc" "Enter" { ScrollToBottom; SwitchToMode "Normal"; }
    bind "j" "Down" { ScrollDown; }
    bind "k" "Up" { ScrollUp; }
    bind "Ctrl f" "PageDown" { PageScrollDown; }
    bind "Ctrl b" "PageUp" { PageScrollUp; }
    bind "d" { HalfPageScrollDown; }
    bind "u" { HalfPageScrollUp; }
    bind "g" { ScrollToTop; }
    bind "G" { ScrollToBottom; }
    bind "[" { ScrollToPreviousPrompt; }
    bind "]" { ScrollToNextPrompt; }
    bind "m" { SelectCommandAtScrollPosition; }
    bind "c" { CopyLastCommandOutput; SwitchToMode "Normal"; }
    bind "e" { EditScrollback; SwitchToMode "Normal"; }
    bind "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
    bind "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
  }

  entersearch {
    bind "Enter" { SwitchToMode "Search"; }
    bind "Esc" "Ctrl c" { SwitchToMode "Normal"; }
  }

  search {
    bind "Esc" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
    bind "n" { Search "Down"; }
    bind "p" { Search "Up"; }
    bind "j" "Down" { ScrollDown; }
    bind "k" "Up" { ScrollUp; }
    bind "Ctrl f" "PageDown" { PageScrollDown; }
    bind "Ctrl b" "PageUp" { PageScrollUp; }
    bind "d" { HalfPageScrollDown; }
    bind "u" { HalfPageScrollUp; }
    bind "c" { SearchToggleOption "CaseSensitivity"; }
    bind "w" { SearchToggleOption "Wrap"; }
    bind "o" { SearchToggleOption "WholeWord"; }
  }

  renametab {
    bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
    bind "Esc" { UndoRenameTab; SwitchToMode "Tmux"; }
  }

  // Alt-chords are free in the tmux keymap, so these zellij conveniences stay
  // available everywhere without stealing a tmux key.
  shared_except "locked" {
    bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
    bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
    bind "Alt j" "Alt Down" { MoveFocus "Down"; }
    bind "Alt k" "Alt Up" { MoveFocus "Up"; }
    bind "Alt n" { NewPane; }
    bind "Alt f" { ToggleFloatingPanes; }
    bind "Alt i" { MoveTab "Left"; }
    bind "Alt o" { MoveTab "Right"; }
    bind "Alt =" "Alt +" { Resize "Increase"; }
    bind "Alt -" { Resize "Decrease"; }
    bind "Alt [" { PreviousSwapLayout; }
    bind "Alt ]" { NextSwapLayout; }
  }
}

pane_frames false

theme "catppuccin-mocha"

mouse_mode true
session_serialization true

default_layout "terminal"
