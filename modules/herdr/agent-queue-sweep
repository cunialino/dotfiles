#!/usr/bin/env bash
# agent-queue-sweep -- run the agent queue once per repository under ROOT that
# actually has pending work. Installed next to `agent-queue`; the systemd user
# timer generated by `modules.herdr.queue.watch.roots` is its intended caller.
#
# Why a sweep instead of one path unit per repository: a systemd path unit needs
# the directory to be named at eval time, and "every repository in ~/builds" is
# not a thing the flake knows. This walks the tree at run time instead, so a repo
# cloned this afternoon is watched without a rebuild.
#
# Discovery is deliberately cheap, because systemd asks every interval:
#   - the repo must be a git repo with a tasks/ directory
#   - it must contain a task file whose `agent/<name>` branch does not exist yet
# A repo with nothing pending is not entered at all: no driver process, no log
# lines, no notification. Everything else -- the run lock, the verifier deny list,
# the refusal to merge -- is the driver's business, unchanged.
#
# Exit codes: 0 nothing needed attention, 2 some repo failed preflight. "Tasks
# are not green" is the child's exit 1 and is deliberately not escalated here;
# the child's own notification is what tells a human.

set -uo pipefail

ROOT="${1:-}"
shift || true
if [[ -z "$ROOT" ]]; then
  printf 'usage: agent-queue-sweep ROOT [extra agent-queue args...]\n' >&2
  exit 2
fi
[[ -d "$ROOT" ]] || { printf '✗ sweep root does not exist: %s\n' "$ROOT" >&2; exit 2; }

AGENT_QUEUE="${AGENT_QUEUE:-@agentQueueBin@}"
EXCLUDE="${QUEUE_SWEEP_EXCLUDE:-@sweepExclude@}"
# Don't let a sweep that starts a long chain of repos run into the next one. The
# check happens before each repo, so a batch already in flight is never cut short.
DEADLINE_SECS="${QUEUE_SWEEP_DEADLINE:-1800}"

started=$(date +%s)
seen=0
ran=0
rc_all=0

shopt -s nullglob
for repo in "$ROOT"/*/; do
  if (( $(date +%s) - started >= DEADLINE_SECS )); then
    printf '! sweep deadline (%ss) reached -- remaining repos wait for the next run\n' "$DEADLINE_SECS" >&2
    break
  fi

  [[ -d "${repo}tasks" ]] || continue
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || continue
  [[ -n "$EXCLUDE" && "$repo" =~ $EXCLUDE ]] && continue
  seen=$((seen + 1))

  pending=0
  for tf in "${repo}"tasks/*.md; do
    name=${tf##*/}
    name=${name%.md}
    # already produced a branch -> already answered, whatever the verdict was
    git -C "$repo" rev-parse --verify --quiet "refs/heads/agent/$name" >/dev/null && continue
    # refused (deny list) or unstartable (bad name, worktree failure) at exactly these
    # bytes -> retrying it every interval would train you to ignore the notifications
    # that matter, and in the setup case it retries forever
    skipped_before=0
    for kind in refused blocked; do
      if [[ -f "${repo}.agent-queue/$kind/$name" ]] &&
         ( cd "$repo" && sha256sum -c --status ".agent-queue/$kind/$name" ) >/dev/null 2>&1; then
        skipped_before=1
        break
      fi
    done
    ((skipped_before)) && continue
    pending=1
    break
  done
  ((pending)) || continue

  ran=$((ran + 1))
  printf '\n» sweep :: %s\n' "$repo" >&2
  rc=0
  ( cd "$repo" && "$AGENT_QUEUE" --allow-empty --skip-locked "$@" ) || rc=$?
  note_rc=$rc
  case "$note_rc" in
    0) printf '» %s :: done\n' "$repo" >&2 ;;
    1) printf '! %s :: tasks need a human\n' "$repo" >&2 ;;
    *) rc_all=2; printf '✗ %s :: preflight failed (exit %s)\n' "$repo" "$note_rc" >&2 ;;
  esac
done

printf '» sweep :: %d repo(s) with tasks/, %d run in %ss\n' "$seen" "$ran" "$(( $(date +%s) - started ))" >&2
exit "$rc_all"
